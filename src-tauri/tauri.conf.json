{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xTiles",
  "version": "2.0.0",
  "identifier": "com.xtiles.snap",
  "mainBinaryName": "xtiles-snap",
  "build": {
    "devUrl": "https://xtiles.app/user/login",
    "frontendDist": "https://xtiles.app/user/login"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Unofficial xTiles desktop application",
    "longDescription": "Unofficial xTiles desktop application for Linux, Windows, and macOS.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    }
  }
}
