{
  "name": "xtiles-snap",
  "version": "1.0.9",
  "description": "xTiles application for Linux",
  "packageManager": "pnpm@10.33.0",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "start": "pnpm run build && electron .",
    "lint": "eslint .",
    "test": "pnpm run build && playwright test",
    "snap": "pnpm run build && electron-builder --linux snap",
    "deb": "pnpm run build && electron-builder --linux deb"
  },
  "build": {
    "productName": "xTiles",
    "appId": "com.xtiles.snap",
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        {
          "target": "snap",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility"
    },
    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "summary": "xTiles application for Linux",
      "description": "Unofficial xTiles application for Linux"
    },
    "files": [
      "dist/main/**/*",
      "build/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "xtiles",
    "electron",
    "linux",
    "deb",
    "snap",
    "snapcraft"
  ],
  "author": {
    "name": "Andre Carbajal Vargas",
    "email": "carbajalvargasandre@gmail.com"
  },
  "homepage": "https://github.com/andre-carbajal/xtiles-snap",
  "bugs": {
    "url": "https://github.com/andre-carbajal/xtiles-snap/issues"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.1.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "playwright": "^1.58.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
